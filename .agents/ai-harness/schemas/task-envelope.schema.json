{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lol-civil-war-helper.local/schemas/task-envelope.schema.json",
  "title": "Sanitized canonical AI task envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "original_request",
    "acceptance_criteria",
    "base_commit",
    "approved_scope",
    "scope_paths",
    "constraints"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "original_request": {"type": "string", "minLength": 1},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
    "repository": {"type": "string"},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "approved_scope": {"type": "array", "items": {"type": "string"}},
    "scope_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\.ai-runtime(?:/|$))(?!\\.git(?:/|$))[^\\\\*?\\[\\]]+(?:/\\*\\*)?$"}
    },
    "constraints": {"type": "array", "items": {"type": "string"}},
    "source_references": {"type": "array", "items": {"type": "string"}}
  }
}
